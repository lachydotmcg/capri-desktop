    <EmbeddedResource Include="../assets/voice/*.wav" LogicalName="Capri.Voice.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/chip.png" LogicalName="Capri.Chip.png" />
    <EmbeddedResource Include="../assets/words/*.txt" LogicalName="Capri.Words.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/cursor.png" LogicalName="Capri.Cursor.png" />
    <AvaloniaResource Include="../assets/fonts/CapriMainframe-Bold.ttf" Link="Assets/CapriMainframe-Bold.ttf" />
    <AvaloniaResource Include="../assets/fonts/ShareTechMono-Regular.ttf" Link="Assets/ShareTechMono-Regular.ttf" />
    <AvaloniaResource Include="../assets/fonts/Barlow*.ttf" Link="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/fonts/Barlow-OFL.txt" LogicalName="Capri.Font.Barlow-OFL.txt" />
  </ItemGroup>
  <PropertyGroup>
    <CapriMic>$(BaseIntermediateOutputPath)capri-mic</CapriMic>
  </PropertyGroup>
  <Target Name="CapriMicBuild" Inputs="mac/Mic.swift" Outputs="$(CapriMic)">
    <Exec Command="swiftc -O -target arm64-apple-macos15.0 mac/Mic.swift -o &quot;$(CapriMic)-arm64&quot; &amp;&amp; swiftc -O -target x86_64-apple-macos15.0 mac/Mic.swift -o &quot;$(CapriMic)-x64&quot; &amp;&amp; lipo -create &quot;$(CapriMic)-arm64&quot; &quot;$(CapriMic)-x64&quot; -output &quot;$(CapriMic)&quot;" />
  </Target>
  <Target Name="CapriMic" DependsOnTargets="CapriMicBuild" BeforeTargets="AssignTargetPaths" Condition="$([MSBuild]::IsOSPlatform('OSX')) And ('$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('osx')))">
    <ItemGroup>
      <None Include="$(CapriMic)" Link="capri-mic" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
