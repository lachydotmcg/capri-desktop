<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Capri</AssemblyName>
    <RootNamespace>CapriDesktop</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);CROSS</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CA1416;SYSLIB0014</NoWarn>
    <Version>0.9.0</Version>
    <Product>Capri</Product>
    <ApplicationIcon>../assets/chip.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Code mods compile against her own loaded assemblies when she's one file on Linux (cross/ModCompiler.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Roslyn's error lines stay in English, like the rest of her, instead of shipping a folder per language. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../docs/provenance/SkiaSharp/LICENSE.md" Link="licenses/native-font-bootstrap-SkiaSharp-MIT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="native/capri-input" Condition="Exists('native/capri-input')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="bridge/**/*.py;bridge/**/*.json;bridge/**/*.md;bridge/**/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../app/Brain.cs" Link="Shared/Brain.cs" />
    <Compile Include="../app/Leaks.cs" Link="Shared/Leaks.cs" />
    <Compile Include="../app/Care.cs" Link="Shared/Care.cs" />
    <Compile Include="../app/Engine.cs" Link="Shared/Engine.cs" />
    <Compile Include="../app/FileFinder.cs" Link="Shared/FileFinder.cs" />
    <Compile Include="../app/Websites.cs" Link="Shared/Websites.cs" />
    <Compile Include="../app/GameNotes.cs" Link="Shared/GameNotes.cs" />
    <Compile Include="../app/Reminders.cs" Link="Shared/Reminders.cs" />
    <Compile Include="../app/Hands.cs" Link="Shared/Hands.cs" />
    <Compile Include="../app/Husk.cs" Link="Shared/Husk.cs" />
    <Compile Include="../app/Presence.cs" Link="Shared/Presence.cs" />
    <Compile Include="../app/Retention.cs" Link="Shared/Retention.cs" />
    <Compile Include="../app/Mods.cs" Link="Shared/Mods.cs" />
    <Compile Include="../app/ModDirectory.cs" Link="Shared/ModDirectory.cs" />
    <Compile Include="../app/ModApi.cs" Link="Shared/ModApi.cs" />
    <Compile Include="../app/CodeMods.cs" Link="Shared/CodeMods.cs" />
    <Compile Include="../app/ArtColors.cs" Link="Shared/ArtColors.cs" />
    <Compile Include="../app/SkinMods.cs" Link="Shared/SkinMods.cs" />
    <Compile Include="../app/SkillMods.cs" Link="Shared/SkillMods.cs" />
    <Compile Include="../app/SoundsLike.cs" Link="Shared/SoundsLike.cs" />
    <Compile Include="../app/Voice.cs" Link="Shared/Voice.cs" />
    <Compile Include="../app/VoicePack.cs" Link="Shared/VoicePack.cs" />
    <EmbeddedResource Include="../assets/sprites/*.png" LogicalName="Capri.Sprite.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/voice/*.wav" LogicalName="Capri.Voice.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/chip.png" LogicalName="Capri.Chip.png" />
    <EmbeddedResource Include="../assets/cursor.png" LogicalName="Capri.Cursor.png" />
    <AvaloniaResource Include="../assets/fonts/CapriMainframe-Bold.ttf" Link="Assets/CapriMainframe-Bold.ttf" />
    <AvaloniaResource Include="../assets/fonts/ShareTechMono-Regular.ttf" Link="Assets/ShareTechMono-Regular.ttf" />
    <AvaloniaResource Include="../assets/fonts/Barlow*.ttf" Link="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/fonts/Barlow-OFL.txt" LogicalName="Capri.Font.Barlow-OFL.txt" />
  </ItemGroup>
</Project>
